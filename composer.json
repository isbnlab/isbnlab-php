{
    "name": "isbnlab/isbnlab-php",
    "description": "Official PHP client for the ISBNLab book metadata API: look up books by ISBN, authors, publishers, subjects, BISAC genres, covers and editions, and validate and convert ISBNs.",
    "type": "library",
    "keywords": ["isbn", "isbn-10", "isbn-13", "ean", "asin", "books", "book-metadata", "bisac", "isbnlab", "api", "sdk"],
    "homepage": "https://www.isbnlab.com/api-information",
    "license": "MIT",
    "authors": [
        {"name": "ISBNLab", "email": "hello@isbnlab.com", "homepage": "https://www.isbnlab.com"}
    ],
    "support": {
        "issues": "https://github.com/isbnlab/isbnlab-php/issues",
        "source": "https://github.com/isbnlab/isbnlab-php",
        "docs": "https://www.isbnlab.com/api-information"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {"ISBNLab\\": "lib/"}
    },
    "autoload-dev": {
        "psr-4": {"ISBNLab\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true
    }
}
